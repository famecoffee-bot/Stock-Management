rules_version = '2';

// Security rules for the Grove stock app's OWN database ("stock") in the grove-mart project.
// grove-system-kh uses the "(default)" database, whose rules are NOT in this repo and are never
// deployed from here. Deploy these with: firebase deploy --only firestore:stock
service cloud.firestore {
  match /databases/{database}/documents {

    function invMe() {
      return get(/databases/$(database)/documents/inv_users/$(request.auth.uid)).data;
    }
    function invUser() {
      return request.auth != null
        && exists(/databases/$(database)/documents/inv_users/$(request.auth.uid))
        && invMe().active == true;
    }
    function invAdmin() {
      return invUser() && invMe().role in ['owner', 'admin'];
    }
    function invOwner() {
      return invUser() && invMe().role == 'owner';
    }
    // At least `need` rights at one branch ('viewer' < 'staff' < 'manager'); admins always.
    function invAtBranch(branchId, need) {
      let r = invMe().branchRoles.get(branchId, '');
      let rank = {'viewer': 1, 'staff': 2, 'manager': 3};
      return invAdmin()
        || (invUser() && r != '' && rank[r] >= rank[need]);
    }
    function invUserDocOk(d) {
      return d.keys().hasOnly(['name', 'email', 'role', 'branchRoles', 'active', 'createdByStock', 'createdAt', 'updatedAt', 'updatedBy'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && d.role in ['owner', 'admin', 'member']
        && d.branchRoles is map
        && d.active is bool;
    }

    // ---- settings (exchange rate, categories): everyone reads, admins write
    match /inv_settings/{id} {
      allow read: if invUser();
      allow write: if invAdmin();
    }

    // ---- branches and items: everyone reads, admins write; never deleted (history needs them)
    match /inv_branches/{id} {
      allow read: if invUser();
      allow create, update: if invAdmin()
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.code is string && request.resource.data.code.size() <= 8
        && request.resource.data.active is bool;
      allow delete: if false;
    }
    match /inv_items/{id} {
      allow read: if invUser();
      allow create, update: if invAdmin()
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.baseUnit in ['g', 'ml', 'pcs']
        && request.resource.data.unitsPerPurchase is number && request.resource.data.unitsPerPurchase > 0
        && request.resource.data.lastCostUsd is number && request.resource.data.lastCostUsd >= 0
        && request.resource.data.active is bool;
      allow delete: if false;
    }

    // ---- users: a person reads their own profile; admins read all and edit (not owners, unless owner)
    match /inv_users/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow read: if invAdmin();
      // profiles are created only by Cloud Functions (invClaimOwner, invCreateUser)
      allow create: if false;
      // admins edit others; only owners may touch an owner or hand out "owner"
      allow update: if invAdmin() && request.auth.uid != uid
        && invUserDocOk(request.resource.data)
        && request.resource.data.email == resource.data.email
        && request.resource.data.get('createdByStock', false) == resource.data.get('createdByStock', false)
        && (invOwner() || (resource.data.role != 'owner' && request.resource.data.role != 'owner'));
      allow delete: if false;
      // new staff logins are created by the invCreateUser Cloud Function (Admin SDK)
    }

    // ---- stock numbers, the movement ledger and expiry batches: read by branch,
    //      written ONLY by Cloud Functions (functions/stock-api.js)
    match /inv_stock/{id} {
      allow read: if invUser() && invAtBranch(resource.data.branchId, 'viewer');
      allow write: if false;
    }
    match /inv_movements/{id} {
      allow read: if invUser() && invAtBranch(resource.data.branchId, 'viewer');
      allow write: if false;
    }
    match /inv_batches/{id} {
      allow read: if invUser() && invAtBranch(resource.data.branchId, 'viewer');
      allow write: if false;
    }
    // ---- transfers: both branches can see them; changed only by Cloud Functions
    match /inv_transfers/{id} {
      allow read: if invUser()
        && (invAtBranch(resource.data.fromBranchId, 'viewer') || invAtBranch(resource.data.toBranchId, 'viewer'));
      allow write: if false;
    }

    // ---- Phase 3: suppliers. Everyone reads (to see who sells what); admins write; never deleted.
    function invSupplierOk(d) {
      return d.keys().hasOnly(['name', 'contactName', 'phone', 'telegram', 'email', 'address', 'paymentTerms',
                               'leadTimeDays', 'itemIds', 'note', 'active', 'createdAt', 'updatedAt', 'updatedBy'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && d.itemIds is list && d.itemIds.size() <= 300
        && d.leadTimeDays is number && d.leadTimeDays >= 0
        && d.active is bool;
    }
    match /inv_suppliers/{id} {
      allow read: if invUser();
      allow create, update: if invAdmin() && invSupplierOk(request.resource.data);
      allow delete: if false;
    }
    // ---- purchase orders: read by branch; created, changed and received ONLY by Cloud Functions
    //      (functions/purchasing-api.js), because receiving one changes stock.
    match /inv_purchase_orders/{id} {
      allow read: if invUser() && invAtBranch(resource.data.branchId, 'viewer');
      allow write: if false;
    }
    // ---- running numbers (PO-0001, ...): only Cloud Functions touch these
    match /inv_counters/{id} {
      allow read, write: if false;
    }
  }
}
